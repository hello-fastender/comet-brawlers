{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "typeRoots": ["/opt/node-tools/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/kern/**/*.ts", "src/pruef/**/*.ts", "tests/**/*.ts"]
}
