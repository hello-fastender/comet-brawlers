# Pixelschriften der Darstellung: 5 × 7 für Anzeige und große Texte, 3 × 5
# für die Debug-Anzeige. Eigene Bitmaps statt Systemschrift, damit die Texte
# im Raster 384 × 224 scharf und auf jedem Rechner gleich sind (auch in den
# Bildschirmfotos). Großbuchstaben, Ziffern, Umlaute und einige Zeichen;
# Kleinbuchstaben werden groß geschrieben, Unbekanntes als „?“. Keine Logik.
# Gezeichnet wird mit DarstellungZeichner.text in Spielpixeln.
# Port von spiel/src/darstellung/schrift.ts.
class_name DarstellungSchrift
extends RefCounted


## Eine Schrift: Glyphen als Zeilen aus „#“ (gesetzt) und „.“ (frei).
class Schrift:
	var breite: int = 0
	var hoehe: int = 0
	## Vorschub je Zeichen in px (Breite plus Abstand)
	var vorschub: int = 0
	## Zeichen (String) → Array von Zeilen (String)
	var glyphen: Dictionary = {}


