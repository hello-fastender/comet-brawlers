## Ersatzzeichen für unbekannte Zeichen.
const ERSATZ: String = "?"

## Schrift 5 × 7 mit 1 px Abstand (Anzeigeleiste, große Texte).
static var SCHRIFT_5X7: Schrift = _schriftNeu(5, 7, 6, G5)
## Schrift 3 × 5 mit 1 px Abstand (Debug-Anzeige).
static var SCHRIFT_3X5: Schrift = _schriftNeu(3, 5, 4, G3)


static func _schriftNeu(breite: int, hoehe: int, vorschub: int, glyphen: Dictionary) -> Schrift:
	var s: Schrift = Schrift.new()
	s.breite = breite
	s.hoehe = hoehe
	s.vorschub = vorschub
	s.glyphen = glyphen
	return s


## Glyphe eines Zeichens: wie geschrieben, sonst groß geschrieben, sonst das Ersatzzeichen.
static func glyphe(s: Schrift, zeichen: String) -> Array:
	if s.glyphen.has(zeichen):
		return s.glyphen[zeichen]
	var gross: String = zeichen.to_upper()
	if s.glyphen.has(gross):
		return s.glyphen[gross]
	return s.glyphen[ERSATZ]


## Breite eines Textes in px (ohne den Abstand nach dem letzten Zeichen).
static func textBreite(s: Schrift, text: String, faktor: int = 1) -> int:
	var n: int = text.length()
	if n == 0:
		return 0
	return (n * s.vorschub - (s.vorschub - s.breite)) * faktor
